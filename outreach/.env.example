# Zoho Mail App Passwords for Outreach Senders
# If all 3 mailboxes use the same password or master password:
ZOHO_PASSWORD=your_zoho_password_here

# Or set individual passwords per mailbox if different:
# ZOHO_PASS_KAYODE=your_app_password
# ZOHO_PASS_CHRISTOPHER=your_app_password
# ZOHO_PASS_WILLIAM=your_app_password
